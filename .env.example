# StudentOS Environment Configuration
# Copy this file to .env and edit as needed.
# No AWS account is required — all services run locally.

# ─── Server ───────────────────────────────────────────────────────────────────
# ENV=production enforces real JWT_SECRET, DB_PASSWORD, DB_SSLMODE != disable
PORT=8080
ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Database (PostgreSQL 16 + pgvector) ──────────────────────────────────────
# Either DATABASE_URL (hosted providers; include ?sslmode=require)
# or the DB_* parts below. DATABASE_URL wins when both are set.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=studentos
DB_PASSWORD=studentos_dev_password
DB_NAME=studentos_db
DB_SSLMODE=disable

# ─── Authentication & JWT ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32  (min 32 chars in production)
JWT_SECRET=
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Header holding the real client IP, set by the edge proxy.
# Leave empty locally. Never use X-Forwarded-For: clients can forge it.
TRUSTED_PLATFORM=

# ─── Ingestion Worker ────────────────────────────────────────────────────────
# Board slugs (optional; defaults in backend/internal/ingest/ingest.go)
# Greenhouse: "slug" or "slug:Display Name"; Lever and Ashby: "slug:Display Name"
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
ASHBY_BOARDS=

# Shared secret for the scheduled-ingest route (POST /internal/ingest).
# Leave EMPTY to disable the route entirely.
# Set it where a scheduler calls in (LocalStack EventBridge, cron, etc.).
INGEST_TOKEN=

# ─── LocalStack (Build It — AWS-compatible local services) ────────────────────
# These are used by LocalStack and the awslocal CLI. No real AWS account needed.
LOCALSTACK_ENDPOINT=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=studentos-assets

# ─── Frontend (build time) ───────────────────────────────────────────────────
# API origin when not served behind the same domain as /api.
# Leave empty when using the nginx container (it proxies /api to the backend).
VITE_API_URL=
