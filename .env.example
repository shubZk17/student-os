# StudentOS Environment Configuration

# Server (ENV=production enforces a real JWT_SECRET, DB_PASSWORD, DB_SSLMODE != disable)
PORT=8080
ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL with pgvector). Either DATABASE_URL (hosted providers; include
# ?sslmode=require) or the DB_* parts below. DATABASE_URL wins when both are set.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=studentos
DB_PASSWORD=studentos_dev_password
DB_NAME=studentos_db
DB_SSLMODE=disable

# Authentication & JWT
# Generate with: openssl rand -hex 32  (min 32 chars in production)
JWT_SECRET=
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Header holding the real client IP, set by the edge proxy (Render: CF-Connecting-IP).
# Leave empty locally. Never use X-Forwarded-For: clients can forge it.
TRUSTED_PLATFORM=

# Ingestion worker boards (optional; defaults in backend/cmd/worker/main.go)
# Greenhouse: "slug" or "slug:Display Name"; Lever and Ashby: "slug:Display Name"
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
ASHBY_BOARDS=

# Frontend (build time): API origin when not served behind the same domain as /api
VITE_API_URL=
